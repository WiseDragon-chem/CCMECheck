# ---- 运行环境 ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# 对外可访问的基础地址，用于拼接签名图片地址等
PUBLIC_BASE_URL=http://localhost:3000

# ---- 数据库 ----
# 相对路径以 server/ 为基准解析。必须放在本地磁盘，不能放在 OneDrive 等同步目录（WAL 会失效）。
DATABASE_URL=file:./prisma/dev.db

# ---- 密钥 ----
# 两把密钥都必须随机生成，且互不相同（相同会被拒绝启动）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 下面的占位值会让服务启动失败，这是故意的 —— 照抄示例等于把签名密钥公开，
# 任何人都能伪造长期有效的图片地址、或伪造任意已知用户的访问令牌。
JWT_SECRET=replace-me-generate-with-node-crypto-randomBytes-48-base64url
FILE_SIGNING_SECRET=replace-me-generate-a-different-one-as-well

# ---- 令牌有效期 ----
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ACTIVATION_TOKEN_TTL_DAYS=30

# ---- Cookie ----
COOKIE_DOMAIN=
COOKIE_NAME=ccme_refresh

# ---- CORS ----
# 逗号分隔的前端来源白名单
CORS_ORIGINS=http://localhost:5173

# ---- 反向代理 ----
# Express 的 trust proxy。默认 false：req.ip 取 socket 地址，不信任 X-Forwarded-For。
# 只有确实部署在可信反向代理之后才改（设为代理跳数，例如 1）。
# 设为跳数以后 req.ip 来自 X-Forwarded-For —— 必须由该代理覆写这个头，
# 否则客户端可以自己申报 IP，绕过登录/激活限流并污染审计日志里的 ip。
TRUST_PROXY=false

# ---- 私有文件存储 ----
STORAGE_ROOT=./storage

# ---- 种子管理员（仅 seed 脚本使用）----
SEED_ADMIN_STUDENT_ID=admin
SEED_ADMIN_NAME=系统管理员
# 留空则随机生成并在 seed 时打印一次
SEED_ADMIN_PASSWORD=

# ---- 数据库备份 ----
# 每日 VACUUM INTO 一致性快照的输出目录；同样不能放在同步盘上
BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=30

# ---- 证明材料保留期（§18.8）----
# 活动结束多少天后删除证明材料。0 = 永不自动删除（默认）。
# 自动删除用户上传的材料不可逆，必须显式开启。
EVIDENCE_RETENTION_DAYS=0

# ---- 种子审核员（仅 seed 脚本使用）----
SEED_REVIEWER_STUDENT_ID=reviewer
SEED_REVIEWER_NAME=审核员
# 留空则随机生成并在 seed 时打印一次
SEED_REVIEWER_PASSWORD=
