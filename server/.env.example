# ---- 运行环境 ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# 对外可访问的基础地址，用于拼接签名图片地址等
PUBLIC_BASE_URL=http://localhost:3000

# ---- 数据库 ----
# 相对路径以 server/ 为基准解析。必须放在本地磁盘，不能放在 OneDrive 等同步目录（WAL 会失效）。
DATABASE_URL=file:./prisma/dev.db

# ---- 密钥 ----
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
FILE_SIGNING_SECRET=replace-me-with-a-different-long-random-string

# ---- 令牌有效期 ----
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ACTIVATION_TOKEN_TTL_DAYS=30

# ---- Cookie ----
COOKIE_DOMAIN=
COOKIE_NAME=ccme_refresh

# ---- CORS ----
# 逗号分隔的前端来源白名单
CORS_ORIGINS=http://localhost:5173

# ---- 私有文件存储 ----
STORAGE_ROOT=./storage

# ---- 种子管理员（仅 seed 脚本使用）----
SEED_ADMIN_STUDENT_ID=admin
SEED_ADMIN_NAME=系统管理员
# 留空则随机生成并在 seed 时打印一次
SEED_ADMIN_PASSWORD=

# ---- 数据库备份 ----
# 每日 VACUUM INTO 一致性快照的输出目录；同样不能放在同步盘上
BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=30
