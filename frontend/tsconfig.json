{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    /**
     * 这个项目里到处是 rows[i]、cards[0]、tracks.find(...)。
     * 打开它，空队列与已停用赛道这两条路径就必须被显式处理 ——
     * 而那恰恰是本产品最容易出事的地方。
     */
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /** 强制 import type，对生成的 api.d.ts 尤其重要 */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,

    "types": ["vite/client", "node"],
    /**
     * 不配 baseUrl：TS 5.9 已把它标记为弃用（编辑器会标红），
     * 而它此前唯一的用处就是给 paths 一个解析基准 —— 从 TS 4.1 起
     * 映射可以省略 baseUrl，按 tsconfig 所在目录解析。
     *
     * 代价是路径要写成 ./src/*，多两个字符，换来这一项不再是弃用状态。
     */
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "e2e", "tools", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "playwright-report", "test-results"]
}
